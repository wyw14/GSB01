{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "rootDir": "src",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/shared", "src/tests", "src/client/previewController.ts"],
  "exclude": ["node_modules", "dist", "src/client/main.ts", "src/client/api.ts"]
}
